<?xml version="1.0" encoding="utf-8"?>
<!--
    Estructura correcta:
    - CardView tiene marginTop=60dp para dejar espacio al círculo encima
    - Círculo en layout_gravity="top|center_horizontal" sin translationY, se superpone al card
    - Botón usa paddingBottom + translationY para sobresalir abajo
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="28dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Tarjeta con fondo degradado negro, baja 60dp para que el círculo quede encima -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dialog_reto"
            android:paddingTop="68dp"
            android:paddingBottom="44dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:gravity="center_horizontal">

            <!-- Línea divisora naranja -->
            <View
                android:id="@+id/divider"
                android:layout_width="48dp"
                android:layout_height="2dp"
                android:background="#FF6B00"
                android:alpha="0.7"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <!-- Texto del reto -->
            <TextView
                android:id="@+id/tvReto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.4"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Círculo pokemon: se superpone al borde superior del card (layout_gravity top) -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="top|center_horizontal">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_pokemon_border"/>

        <ImageView
            android:id="@+id/imgPokemon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:contentDescription="@string/cd_pokemon_image"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Botón Cerrar: mitad dentro / mitad fuera del borde inferior -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrar"
        android:layout_width="140dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:translationY="28dp"
        android:text="@string/btn_cerrar"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        app:backgroundTint="@color/orange_cerrar"
        app:cornerRadius="28dp"
        app:elevation="8dp"/>

</FrameLayout>
