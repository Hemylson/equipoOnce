<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_white">

    <!-- Franja naranja decorativa -->
    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:background="@drawable/bg_dialog_accent"/>

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- Ícono decorativo -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_beer"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/cd_retos"/>

        <!-- Título negro bold (criterio) -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar reto"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:layout_marginBottom="6dp"/>

        <!-- Divisor sutil -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:background="#FF6B00"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"/>

        <!-- Campo de texto sobre fondo gris claro -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext_reto"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/etReto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Escriba el reto"
                android:backgroundTint="#FF6B00"
                android:textColor="@android:color/black"
                android:textColorHint="#AAAAAA"
                android:textSize="15sp"
                android:inputType="textCapSentences"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"/>

        </FrameLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cancelar"
                android:textColor="#FF6B00"
                android:textStyle="bold"
                android:textSize="14sp"
                style="?attr/borderlessButtonStyle"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Guardar"
                android:textColor="@color/btn_guardar_text"
                android:textStyle="bold"
                android:textSize="14sp"
                android:enabled="false"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/btn_guardar_stroke"
                app:strokeWidth="2dp"
                app:cornerRadius="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
